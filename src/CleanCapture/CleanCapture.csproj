<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      目标：Windows 10 / 11，64 位。不要改成 AnyCPU 去跑 32 位，
      Graphics Capture + NAudio 环回在 64 位下最稳。
      TargetFramework 后面的 10.0.19041.0 是 Windows SDK 的最低版本，
      也就是 Windows 10 2004，Win10 / Win11 都能跑。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 单文件绿色版：发布命令见 README 第 5 节（dotnet publish，Release，win-x64，自包含，单文件） -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CleanCapture</AssemblyName>
    <RootNamespace>CleanCapture</RootNamespace>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <Description>自用纯净截图录屏小工具：截图 PNG 无损，录屏分真无损 / 高清两档，只录系统声。</Description>
    <Company></Company>
    <Copyright>自用，未发布</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!--
      这两个包是录屏必须的，缺一不可：
      * NAudio：只用来采“系统声”（WASAPI 环回），不碰麦克风。
        装好后 SystemAudioCapture 才能工作。
      * Vortice.Windows：用来建 Direct3D 11 设备，给 Graphics Capture
        提供画布。没有它，GraphicsCaptureSource 里的 D3D 设备建不起来。
      在 Visual Studio 里：右键项目 → 管理 NuGet 程序包 → 搜名字安装，
      或在“包管理器控制台”执行：
        Install-Package NAudio -Version 2.2.1
        Install-Package Vortice.Windows -Version 2.7.0
      版本号写在这里就是为了让你装的时候不用猜；如果 NuGet 上有了
      更新的稳定版，可以升，但升完要在 Win10 / Win11 各跑一次录屏。
    -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="Vortice.Windows" Version="2.7.0" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <ItemGroup>
    <ApplicationDefinition Include="App.xaml" />
    <Page Include="MainWindow.xaml" />
    <Page Include="SettingsWindow.xaml" />
    <Page Include="RegionSelectorWindow.xaml" />
  </ItemGroup>

</Project>
