<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!--
      目标：Windows 10 / 11，64 位。不要改成 AnyCPU 去跑 32 位，
      GDI 截屏 + NAudio 环回在 64 位下最稳。
      TargetFramework 后面的 10.0.19041.0 是 Windows SDK 的最低版本，
      也就是 Windows 10 2004，Win10 / Win11 都能跑。
    -->
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- 单文件绿色版：发布命令见 README 第 5 节（dotnet publish，Release，win-x64，自包含，单文件） -->
    <PlatformTarget>x64</PlatformTarget>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AssemblyName>CleanCapture</AssemblyName>
    <RootNamespace>CleanCapture</RootNamespace>
    <Version>0.1.0</Version>
    <FileVersion>0.1.0.0</FileVersion>
    <Description>自用纯净截图录屏小工具：截图 PNG 无损，录屏分真无损 / 高清两档，只录系统声。</Description>
    <Company></Company>
    <Copyright>自用，未发布</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <!--
      2026-11-18 修复（B 路线：去 Vortice，不换包）：
      云端编译报错 NU1101：原来这里写的 Vortice.Windows 2.7.0
      在 NuGet 上根本不存在——Vortice.Windows 只是项目总名，
      真正的包是 Vortice.Direct3D11 之类。
      换包（A 路线）能过 NU1101，但 GraphicsCaptureSource 里
      WinRT 和 Vortice 之间的接口写法（D3D11CreateDevice 的重载、
      Direct3D11Helper.CreateDirect3DDevice、从 Surface 取纹理）
      有两三处在没有 Windows 编译的情况下核对不了，硬换很可能
      再报一次编译错。所以删掉 Vortice，录屏改走 GDI：
      GdiCaptureSource 按帧率用 CopyFromScreen 逐帧截屏供帧，
      只用截图里已经在用的写法，不引任何新包。
      下面两个包是现在录屏必须的，缺一不可：
      * NAudio：只用来采“系统声”（WASAPI 环回），不碰麦克风。
        装好后 SystemAudioCapture 才能工作。
      * System.Drawing.Common：GDI 截屏（Bitmap / Graphics）用的，
        ScreenshotService 和 GdiCaptureSource 都靠它。
      在 Visual Studio 里：右键项目 → 管理 NuGet 程序包 → 搜名字安装，
      或在“包管理器控制台”执行：
        Install-Package NAudio -Version 2.2.1
        Install-Package System.Drawing.Common -Version 8.0.0
      版本号写在这里就是为了让你装的时候不用猜；如果 NuGet 上有了
      更新的稳定版，可以升，但升完要在 Win10 / Win11 各跑一次录屏。
      核对过（2026-11-18，NuGet 官方接口）：
      NAudio 2.2.1 存在；System.Drawing.Common 8.0.0 存在；
      Vortice.Direct3D11 3.6.2 也存在且支持 net8.0-windows，
      但本项目已不再用 Vortice，所以不引它。
    -->
    <PackageReference Include="NAudio" Version="2.2.1" />
    <PackageReference Include="System.Drawing.Common" Version="8.0.0" />
  </ItemGroup>

  <!--
    2026-11-18 第二次编译修复：原来这里显式写了
    ApplicationDefinition / Page 包含 App.xaml、MainWindow.xaml、
    SettingsWindow.xaml、RegionSelectorWindow.xaml，
    但 SDK 风格的工程默认就会自动包含这些 XAML，
    显式再写一次就报 Duplicate 'Page' items，编译失败。
    删掉这一组，交给 SDK 默认包含即可，不用再手动列。
  -->

</Project>
