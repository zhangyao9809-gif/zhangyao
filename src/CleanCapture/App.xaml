<Application x:Class="CleanCapture.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml"
             ShutdownMode="OnExplicitShutdown">
    <!--
      ShutdownMode 用 OnExplicitShutdown，是因为主窗口关了也不退出：
      程序要缩到托盘里继续等快捷键。只有在托盘菜单点“退出”时才真正退出。
      这一点在 App.xaml.cs 的 ExitApplication 里收尾。
    -->
    <Application.Resources>
        <ResourceDictionary>
            <!--
              全局字体（2026-11-18，学设计图的字体）：
              正文/中文：HarmonyOS Sans SC（圆润现代黑体，像设计图的苹方风格），
              找不到时回落到微软雅黑 / Segoe UI。
              标题/键帽：Poppins（几何粗体无衬线，设计图里 CleanCapture 那个字体）。
              字体文件编在程序集里（Fonts 文件夹），换电脑也一样。
            -->
            <FontFamily x:Key="AppFontFamily">pack://application:,,,/Fonts/#HarmonyOS Sans SC, Microsoft YaHei UI, Segoe UI</FontFamily>
            <FontFamily x:Key="TitleFontFamily">pack://application:,,,/Fonts/#Poppins</FontFamily>
            <!--
              页面底色必须放这里（App 级资源），不能只放在某个窗口自己的 Resources 里：
              窗口标签自己的属性（比如 Background="{StaticResource PageBackground}"）
              是在 Window.Resources 加载之前就求值的，写在窗口里它找不到，
              一启动就报“无法找到名为 PageBackground 的资源”直接闪退。
              2026-11-19 就是这个错导致新版双击打不开。
            -->
            <SolidColorBrush x:Key="PageBackground" Color="#F2F7FF" />
            <Style TargetType="Button">
                <Setter Property="Padding" Value="14,7" />
                <Setter Property="Margin" Value="0,0,8,8" />
                <Setter Property="MinWidth" Value="110" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="Margin" Value="0,0,0,4" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
