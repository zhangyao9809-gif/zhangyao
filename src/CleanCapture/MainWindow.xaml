<Window x:Class="CleanCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanCapture — 截图录屏（自用）"
        Icon="icon.ico"
        Width="520" Height="540"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBackground}">
    <!--
      第二轮打磨（2026-11-18）：往“收费软件”的精致感走。
      渐变标题带、圆角阴影卡片、渐变主按钮、Segoe MDL2 Assets 字形。
      只改样式，不改功能。所有 x:Name、Click 事件、Grid.Row 和控件顺序都和原来一样。
      注意：RecordButton / PauseButton 的文字会在代码里被改成“停止录屏”/“继续”，
      改成纯文字后字形就没了，这是正常的，不会报错。
    -->
    <Window.Resources>
        <!-- 配色 -->
        <SolidColorBrush x:Key="PrimaryBrush" Color="#0E9A8B" />
        <SolidColorBrush x:Key="PrimaryHoverBrush" Color="#0B7D72" />
        <SolidColorBrush x:Key="PrimaryPressedBrush" Color="#09685E" />
        <SolidColorBrush x:Key="DeepBlueBrush" Color="#14557A" />
        <SolidColorBrush x:Key="PageBackground" Color="#F8FAFB" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#DFE7EB" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#1F2A33" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#6B7A85" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#CBD6DC" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#EFF5F6" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#E3ECEE" />
        <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#F2F4F5" />
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#9AA7AF" />
        <SolidColorBrush x:Key="HintPanelBrush" Color="#EFF5F6" />
        <SolidColorBrush x:Key="FooterBrush" Color="#EFF4F6" />
        <!-- 标题带和主按钮共用的青→深蓝渐变（取自专属图标） -->
        <LinearGradientBrush x:Key="HeaderGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0E9A8B" Offset="0" />
            <GradientStop Color="#0B7D8A" Offset="0.55" />
            <GradientStop Color="#14557A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0E9A8B" Offset="0" />
            <GradientStop Color="#14557A" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryHoverGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#0B8A7B" Offset="0" />
            <GradientStop Color="#0F4A68" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryPressedGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#09685E" Offset="0" />
            <GradientStop Color="#0D3F5C" Offset="1" />
        </LinearGradientBrush>

        <!--
          两个按钮模板分开写，不共用：
          模板里的 Trigger 优先级高于 Style 里的 Trigger，
          如果主按钮只靠 Style.Trigger 改悬停色，会被模板的
          悬停 Trigger 盖掉（白字 + 浅底，看不清）。所以主按钮
          有自己的一套模板，悬停/按下颜色写死在模板里。
        -->
        <ControlTemplate x:Key="CleanButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ButtonDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="6" ShadowDepth="1" Direction="270"
                                      Opacity="0.25" Color="#14557A" />
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center"
                                  VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverGradientBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverGradientBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryPressedGradientBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryPressedGradientBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ButtonDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 卡片模板：白底圆角 + 细腻阴影，标题上方一条青色小横线点缀 -->
        <ControlTemplate x:Key="CardGroupBoxTemplate" TargetType="GroupBox">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="10"
                    Padding="{TemplateBinding Padding}">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="8" ShadowDepth="1" Direction="270"
                                      Opacity="0.12" Color="#1F2A33" />
                </Border.Effect>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel Margin="0,0,0,10">
                        <Rectangle Width="26" Height="3" Fill="{StaticResource PrimaryBrush}"
                                   RadiusX="1.5" RadiusY="1.5"
                                   HorizontalAlignment="Left" Margin="0,0,0,6" />
                        <ContentPresenter ContentSource="Header"
                                          TextBlock.FontWeight="Bold"
                                          TextBlock.FontSize="13"
                                          TextBlock.Foreground="{StaticResource DeepBlueBrush}" />
                    </StackPanel>
                    <ContentPresenter Grid.Row="1" />
                </Grid>
            </Border>
        </ControlTemplate>

        <!-- 普通按钮：白底、细边框、8px 圆角 -->
        <Style x:Key="CleanButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="Normal" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource CleanButtonTemplate}" />
        </Style>

        <!-- 主操作按钮：青→深蓝渐变底、白字（只给“开始录屏”用） -->
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CleanButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGradientBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
        </Style>

        <!-- 分组卡片：白底卡片、浅边框、圆角阴影模板 -->
        <Style TargetType="GroupBox">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,12,16,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Template" Value="{StaticResource CardGroupBoxTemplate}" />
        </Style>

        <!-- 下拉框：跟按钮同高，白底 -->
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </Window.Resources>

    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 渐变标题带背景：贴到窗口三边，下方圆角收边；标题文字浮在上面 -->
        <Border Grid.Row="0" Grid.RowSpan="2"
                Background="{StaticResource HeaderGradientBrush}"
                Margin="-24,-20,-24,0" CornerRadius="8,8,12,12" />

        <!-- 标题：图标 + 名字（白字，浮在渐变带上） -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
            <Image Source="icon.png" Width="40" Height="40" Margin="0,0,12,0" />
            <TextBlock FontSize="22" FontWeight="Bold" Foreground="#FFFFFF"
                       VerticalAlignment="Center" Text="CleanCapture" />
        </StackPanel>
        <TextBlock Grid.Row="1" Margin="0,6,0,14" FontSize="13"
                   Foreground="#D6EAF2" TextWrapping="Wrap"
                   Text="自用小工具：截图 PNG 无损，录屏分真无损 / 高清两档，只录系统声，不录麦克风。" />

        <GroupBox Grid.Row="2" Header="截图" Margin="0,14,0,0">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RegionShotButton" Style="{StaticResource CleanButton}"
                        Click="OnRegionShotClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A8;" FontSize="14"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="区域截图" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="FullscreenShotButton" Style="{StaticResource CleanButton}"
                        Click="OnFullscreenShotClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="14"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="全屏截图" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                <Button x:Name="WindowShotButton" Style="{StaticResource CleanButton}"
                        Click="OnWindowShotClick">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="14"
                                   Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="窗口截图…" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="录屏" Margin="0,10,0,0">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RecordButton" Style="{StaticResource PrimaryButton}"
                            Click="OnRecordClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C8;" FontSize="14"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="开始录屏" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PauseButton" Style="{StaticResource CleanButton}"
                            IsEnabled="False" Click="OnPauseClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="14"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="暂停" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <ComboBox x:Name="RecordScopeBox" Width="130" Margin="0,0,8,8" SelectedIndex="0">
                        <ComboBoxItem Content="全屏" />
                        <ComboBoxItem Content="区域…" />
                        <ComboBoxItem Content="窗口…" />
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="StatusText" Margin="0,4,0,0" FontSize="13"
                           FontWeight="SemiBold" Foreground="{StaticResource DeepBlueBrush}"
                           Text="未在录制" />
                <TextBlock x:Name="SizeHintText" Margin="0,4,0,0" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <!-- 快捷键卡片：显示当前生效的四个键（设置里改了，这里跟着变），
             不是写死的文字。想自己改：点下面“设置…”→ 快捷键。 -->
        <GroupBox Grid.Row="4" Header="快捷键" Margin="0,10,0,0">
            <StackPanel>
                <Border Background="{StaticResource HintPanelBrush}" CornerRadius="6" Padding="10,8">
                    <TextBlock x:Name="HotkeyHintText" FontSize="13" FontWeight="Normal"
                               Foreground="{StaticResource TextPrimaryBrush}" TextWrapping="Wrap" />
                </Border>
                <TextBlock Margin="0,8,0,0" FontSize="12"
                           Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap"
                           Text="想自己改：点下面“设置…”→ 快捷键，点一下框、按新组合键就行，保存后马上生效。" />
            </StackPanel>
        </GroupBox>

        <!-- 底部状态条：浅色横条贴到底边，左侧版本信息，右侧两个按钮 -->
        <Border Grid.Row="5" Background="{StaticResource FooterBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"
                Margin="-24,10,-24,-20" Padding="24,10,24,10" CornerRadius="12,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="11"
                           Foreground="{StaticResource TextMutedBrush}"
                           Text="CleanCapture v0.1 · 截图 PNG 无损 · 只录系统声" />
                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource CleanButton}" Margin="0,0,8,0"
                            Click="OnSettingsClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="设置…" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource CleanButton}" Margin="0,0,0,0"
                            Content="最小化到托盘" Click="OnMinimizeToTrayClick" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
