<Window x:Class="CleanCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanCapture — 截图录屏（自用）"
        Icon="icon.ico"
        Width="1160" Height="740"
        MinWidth="1020" MinHeight="660"
        ResizeMode="CanResize"
        WindowStartupLocation="CenterScreen"
        FontFamily="{StaticResource AppFontFamily}"
        Background="{StaticResource PageBackground}">
    <!--
      第三轮重构（2026-11-18）：按设计图重做高级视觉。
      Windows 11 Fluent 风格：冰蓝底、渐变主色、圆角卡片、柔和阴影。
      只改界面和少量状态同步逻辑；截图、录屏、快捷键、托盘的业务逻辑不动。
      和设计图有一处诚实差异（设计稿第 9 条：不伪装未实现的功能）：
      1. 保留系统标准窗口边框（拖动、最大化、还原、关闭都正常），
         不做无边框圆角窗口；圆角体现在卡片和按钮上。
      2. 麦克风开关是真的：2026-11-18 用户决定加上，默认关闭，
         打开才录人声；打不开麦克风时会提示，这次只录系统声。
    -->
    <Window.Resources>
        <!-- ============ 统一主题变量 ============ -->
        <SolidColorBrush x:Key="PageBackground" Color="#F2F7FF" />
        <SolidColorBrush x:Key="CardBackground" Color="#FFFFFF" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#DCE8F7" />
        <SolidColorBrush x:Key="TextPrimaryBrush" Color="#102448" />
        <SolidColorBrush x:Key="TextMutedBrush" Color="#657FA5" />
        <SolidColorBrush x:Key="AccentBlueBrush" Color="#0875F5" />
        <SolidColorBrush x:Key="TealBrush" Color="#00CFAE" />
        <SolidColorBrush x:Key="ButtonBorderBrush" Color="#D6E4F5" />
        <SolidColorBrush x:Key="ButtonHoverBrush" Color="#F2F8FF" />
        <SolidColorBrush x:Key="ButtonPressedBrush" Color="#E6F0FD" />
        <SolidColorBrush x:Key="ButtonDisabledBrush" Color="#F2F4F5" />
        <SolidColorBrush x:Key="TextDisabledBrush" Color="#9AA7AF" />
        <SolidColorBrush x:Key="KeycapBackground" Color="#EAF3FF" />
        <SolidColorBrush x:Key="KeycapBorderBrush" Color="#C9DFF7" />
        <SolidColorBrush x:Key="StatusBarBrush" Color="#EAF3FF" />
        <SolidColorBrush x:Key="OkGreenBrush" Color="#22C55E" />
        <!-- 主色渐变：#00CFAE → #0875F5（设计稿） -->
        <LinearGradientBrush x:Key="PrimaryGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00CFAE" Offset="0" />
            <GradientStop Color="#0875F5" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryHoverGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00BFA0" Offset="0" />
            <GradientStop Color="#0668DD" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="PrimaryPressedGradientBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#00A98D" Offset="0" />
            <GradientStop Color="#0559C4" Offset="1" />
        </LinearGradientBrush>
        <!-- 标题带：极淡的冰蓝磨砂渐变 -->
        <LinearGradientBrush x:Key="HeaderBrush" StartPoint="0,0" EndPoint="1,0">
            <GradientStop Color="#EAF4FF" Offset="0" />
            <GradientStop Color="#E4F7F1" Offset="0.55" />
            <GradientStop Color="#E8F1FF" Offset="1" />
        </LinearGradientBrush>
        <!-- 卡片标题小图标底色 -->
        <LinearGradientBrush x:Key="ShotTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#34D399" Offset="0" />
            <GradientStop Color="#00CFAE" Offset="1" />
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="RecordTileBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#60A5FA" Offset="0" />
            <GradientStop Color="#0875F5" Offset="1" />
        </LinearGradientBrush>

        <!-- ============ 按钮模板 ============ -->
        <!-- 普通按钮模板：白底、细边框、圆角 8，悬停描边变蓝 -->
        <ControlTemplate x:Key="CleanButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="8">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ButtonDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 主按钮模板：渐变底、白字、柔和阴影 -->
        <ControlTemplate x:Key="PrimaryButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="14">
                <Border.Effect>
                    <DropShadowEffect BlurRadius="12" ShadowDepth="4" Direction="270"
                                      Opacity="0.25" Color="#0875F5" />
                </Border.Effect>
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryHoverGradientBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryHoverGradientBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryPressedGradientBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource PrimaryPressedGradientBrush}" />
                </Trigger>
                <Trigger Property="IsEnabled" Value="False">
                    <Setter Property="Background" Value="{StaticResource ButtonDisabledBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
                    <Setter Property="Foreground" Value="{StaticResource TextDisabledBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 截图大按钮模板：白底、圆角 16、悬停提亮描边 -->
        <ControlTemplate x:Key="ShotButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    CornerRadius="16">
                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonHoverBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBlueBrush}" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="{StaticResource ButtonPressedBrush}" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- 开关模板：滑动小圆点，150ms 平滑移动 -->
        <ControlTemplate x:Key="SwitchTemplate" TargetType="ToggleButton">
            <Border x:Name="Track" Background="#CBD8EA" CornerRadius="12"
                    Width="46" Height="24">
                <Ellipse x:Name="Thumb" Width="18" Height="18" Fill="#FFFFFF"
                         HorizontalAlignment="Left" Margin="3,0,0,0">
                    <Ellipse.Effect>
                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Direction="270"
                                          Opacity="0.25" Color="#102448" />
                    </Ellipse.Effect>
                </Ellipse>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Track" Property="Background" Value="{StaticResource AccentBlueBrush}" />
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                    Storyboard.TargetProperty="Margin"
                                                    To="25,0,0,0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>
                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>
                                <ThicknessAnimation Storyboard.TargetName="Thumb"
                                                    Storyboard.TargetProperty="Margin"
                                                    To="3,0,0,0" Duration="0:0:0.15" />
                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>

        <!-- ============ 按钮样式 ============ -->
        <Style x:Key="CleanButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="16,8" />
            <Setter Property="MinWidth" Value="96" />
            <Setter Property="MinHeight" Value="34" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource CleanButtonTemplate}" />
        </Style>

        <!-- 小号文字按钮（底部状态栏用） -->
        <Style x:Key="ToolButton" TargetType="Button" BasedOn="{StaticResource CleanButton}">
            <Setter Property="MinWidth" Value="0" />
            <Setter Property="MinHeight" Value="32" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>

        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource CleanButton}">
            <Setter Property="Background" Value="{StaticResource PrimaryGradientBrush}" />
            <Setter Property="Foreground" Value="#FFFFFF" />
            <Setter Property="BorderBrush" Value="{StaticResource PrimaryGradientBrush}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FontSize" Value="16" />
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="Padding" Value="28,0" />
            <Setter Property="Template" Value="{StaticResource PrimaryButtonTemplate}" />
        </Style>

        <!-- 截图大按钮：纵向图标+名称+说明 -->
        <Style x:Key="ShotButton" TargetType="Button">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="MinHeight" Value="128" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource ShotButtonTemplate}" />
        </Style>

        <!-- 录屏暂停/停止：跟开始录屏同高 58，白底 -->
        <Style x:Key="RecordSideButton" TargetType="Button" BasedOn="{StaticResource CleanButton}">
            <Setter Property="MinHeight" Value="58" />
            <Setter Property="MinWidth" Value="104" />
            <Setter Property="FontSize" Value="15" />
            <Setter Property="Margin" Value="0,0,12,0" />
        </Style>

        <!-- 系统声音开关 -->
        <Style x:Key="SwitchToggle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template" Value="{StaticResource SwitchTemplate}" />
        </Style>

        <!-- 卡片：白底、圆角 20、1px 浅蓝描边、柔和阴影 -->
        <Style x:Key="CardBorder" TargetType="Border">
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource CardBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="20" />
            <Setter Property="Padding" Value="24" />
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="8" Direction="270"
                                      Opacity="0.10" Color="#2659A0" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 下拉框 -->
        <Style TargetType="ComboBox">
            <Setter Property="MinHeight" Value="36" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{StaticResource TextPrimaryBrush}" />
            <Setter Property="Background" Value="{StaticResource CardBackground}" />
            <Setter Property="BorderBrush" Value="{StaticResource ButtonBorderBrush}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!-- 录制红点呼吸动画：录制中循环淡入淡出 -->
        <Storyboard x:Key="RecDotPulse" RepeatBehavior="Forever">
            <DoubleAnimation Storyboard.TargetProperty="Opacity"
                             From="1" To="0.3" Duration="0:0:0.6"
                             AutoReverse="True" />
        </Storyboard>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="110" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= 顶部标题栏 ================= -->
        <Border Grid.Row="0" Background="{StaticResource HeaderBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,0,0,1">
            <Grid Margin="28,0,28,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Image Source="icon.png" Width="64" Height="64" Margin="0,0,16,0" />
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock FontSize="30" FontWeight="Bold"
                                   FontFamily="{StaticResource TitleFontFamily}"
                                   Foreground="{StaticResource TextPrimaryBrush}"
                                   Text="CleanCapture" />
                        <TextBlock FontSize="14" Margin="0,4,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="专业的截图与录屏工具" />
                    </StackPanel>
                    <Border Margin="20,0,0,0" Padding="14,7" CornerRadius="16"
                            Background="#FFFFFF" BorderBrush="{StaticResource CardBorderBrush}"
                            BorderThickness="1" VerticalAlignment="Center">
                        <TextBlock FontSize="13" Foreground="{StaticResource TextMutedBrush}">
                            <Run FontFamily="Segoe MDL2 Assets" Text="&#xE7B8; " Foreground="{StaticResource AccentBlueBrush}" /><Run Text="轻量 · 高清 · 高效" />
                        </TextBlock>
                    </Border>
                </StackPanel>
                <Button Grid.Column="2" Style="{StaticResource CleanButton}"
                        MinWidth="44" MinHeight="44" Padding="0"
                        Click="OnSettingsClick" ToolTip="设置">
                    <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="20"
                               VerticalAlignment="Center" HorizontalAlignment="Center" />
                </Button>
            </Grid>
        </Border>

        <!-- ================= 中部双卡片 ================= -->
        <Grid Grid.Row="1" Margin="28,20,28,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- 截图卡片 -->
            <Border Grid.Column="0" Style="{StaticResource CardBorder}" Margin="0,0,10,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="16"
                                Background="{StaticResource ShotTileBrush}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A8;"
                                       FontSize="28" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Text="截图" />
                            <TextBlock FontSize="14" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="快速捕捉屏幕精彩内容" />
                        </StackPanel>
                    </StackPanel>
                    <Grid Margin="0,24,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" x:Name="RegionShotButton" Style="{StaticResource ShotButton}"
                                Margin="0,0,6,0" Click="OnRegionShotClick">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7A8;" FontSize="30"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                                           HorizontalAlignment="Center" Text="区域截图" />
                                <TextBlock FontSize="12" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Text="自定义区域" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="1" x:Name="FullscreenShotButton" Style="{StaticResource ShotButton}"
                                Margin="6,0,6,0" Click="OnFullscreenShotClick">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE722;" FontSize="30"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                                           HorizontalAlignment="Center" Text="全屏截图" />
                                <TextBlock FontSize="12" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Text="截取整个屏幕" />
                            </StackPanel>
                        </Button>
                        <Button Grid.Column="2" x:Name="WindowShotButton" Style="{StaticResource ShotButton}"
                                Margin="6,0,0,0" Click="OnWindowShotClick">
                            <StackPanel>
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8A7;" FontSize="30"
                                           Foreground="{StaticResource AccentBlueBrush}"
                                           HorizontalAlignment="Center" />
                                <TextBlock FontSize="15" FontWeight="SemiBold" Margin="0,12,0,0"
                                           HorizontalAlignment="Center" Text="窗口截图" />
                                <TextBlock FontSize="12" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextMutedBrush}"
                                           HorizontalAlignment="Center" Text="截取指定窗口" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 录屏卡片 -->
            <Border Grid.Column="1" Style="{StaticResource CardBorder}" Margin="10,0,0,0">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <Border Width="56" Height="56" CornerRadius="16"
                                Background="{StaticResource RecordTileBrush}">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;"
                                       FontSize="28" Foreground="#FFFFFF"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel Margin="16,0,0,0" VerticalAlignment="Center">
                            <TextBlock FontSize="22" FontWeight="Bold"
                                       Foreground="{StaticResource TextPrimaryBrush}" Text="录屏" />
                            <TextBlock FontSize="14" Margin="0,4,0,0"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       Text="高清录制屏幕操作与声音" />
                        </StackPanel>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="0,24,0,0">
                        <Button x:Name="RecordButton" Style="{StaticResource PrimaryButton}"
                                Click="OnRecordClick">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="14" Height="14" Fill="#FF3B30" Stroke="#FFFFFF"
                                         StrokeThickness="2" Margin="0,0,10,0"
                                         VerticalAlignment="Center" />
                                <TextBlock Text="开始录屏" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="PauseButton" Style="{StaticResource RecordSideButton}"
                                IsEnabled="False" Click="OnPauseClick">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="15"
                                           Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock x:Name="PauseButtonText" Text="暂停" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="StopButton" Style="{StaticResource RecordSideButton}"
                                IsEnabled="False" Click="OnStopClick" Margin="0,0,0,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE7C8;" FontSize="15"
                                           Margin="0,0,6,0" VerticalAlignment="Center" />
                                <TextBlock Text="停止" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <Grid Margin="0,20,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                            <StackPanel>
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="录制范围" />
                                <ComboBox x:Name="RecordScopeBox" Width="120" SelectedIndex="0" Margin="0,4,0,0">
                                    <ComboBoxItem Content="全屏" />
                                    <ComboBoxItem Content="区域…" />
                                    <ComboBoxItem Content="窗口…" />
                                </ComboBox>
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE767;" FontSize="18"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="系统声音" />
                                <TextBlock x:Name="SystemAudioStateText" FontSize="13" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="开启" />
                            </StackPanel>
                            <ToggleButton x:Name="SystemAudioToggle" Style="{StaticResource SwitchToggle}"
                                          IsChecked="True" VerticalAlignment="Center"
                                          Checked="OnSystemAudioToggleChanged"
                                          Unchecked="OnSystemAudioToggleChanged" />
                        </StackPanel>
                        <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="24,0,0,0">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE720;" FontSize="18"
                                       Foreground="{StaticResource TextMutedBrush}"
                                       VerticalAlignment="Center" Margin="0,0,8,0" />
                            <StackPanel Margin="0,0,10,0">
                                <TextBlock FontSize="12" Foreground="{StaticResource TextMutedBrush}" Text="麦克风" />
                                <TextBlock x:Name="MicrophoneStateText" FontSize="13" Margin="0,4,0,0"
                                           Foreground="{StaticResource TextPrimaryBrush}" Text="关闭" />
                            </StackPanel>
                            <ToggleButton x:Name="MicrophoneToggle" Style="{StaticResource SwitchToggle}"
                                          IsChecked="False" VerticalAlignment="Center"
                                          Checked="OnMicrophoneToggleChanged"
                                          Unchecked="OnMicrophoneToggleChanged" />
                        </StackPanel>
                    </Grid>
                    <TextBlock x:Name="SizeHintText" Margin="0,16,0,0" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= 快捷键横条 ================= -->
        <Border Grid.Row="2" Style="{StaticResource CardBorder}" Margin="28,20,28,0" Padding="24,18">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="48" Height="48" CornerRadius="14"
                            Background="{StaticResource KeycapBackground}">
                        <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE765;"
                                   FontSize="24" Foreground="{StaticResource AccentBlueBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel Margin="14,0,0,0" VerticalAlignment="Center">
                        <TextBlock FontSize="18" FontWeight="Bold"
                                   Foreground="{StaticResource TextPrimaryBrush}" Text="快捷键" />
                        <TextBlock FontSize="12" Margin="0,2,0,0"
                                   Foreground="{StaticResource TextMutedBrush}"
                                   Text="高效操作，一键直达" />
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="{StaticResource KeycapBackground}"
                                BorderBrush="{StaticResource KeycapBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6">
                            <TextBlock x:Name="HotkeyRegionText" FontFamily="{StaticResource TitleFontFamily}" FontSize="13"
                                       FontWeight="Medium" Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>
                        <TextBlock FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Text="区域截图" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="{StaticResource KeycapBackground}"
                                BorderBrush="{StaticResource KeycapBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6">
                            <TextBlock x:Name="HotkeyFullscreenText" FontFamily="{StaticResource TitleFontFamily}" FontSize="13"
                                       FontWeight="Medium" Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>
                        <TextBlock FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Text="全屏截图" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,20,0">
                        <Border Background="{StaticResource KeycapBackground}"
                                BorderBrush="{StaticResource KeycapBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6">
                            <TextBlock x:Name="HotkeyRecordText" FontFamily="{StaticResource TitleFontFamily}" FontSize="13"
                                       FontWeight="Medium" Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>
                        <TextBlock FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Text="开始/停止录屏" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource KeycapBackground}"
                                BorderBrush="{StaticResource KeycapBorderBrush}" BorderThickness="1"
                                CornerRadius="8" Padding="10,6">
                            <TextBlock x:Name="HotkeyPauseText" FontFamily="{StaticResource TitleFontFamily}" FontSize="13"
                                       FontWeight="Medium" Foreground="{StaticResource AccentBlueBrush}" />
                        </Border>
                        <TextBlock FontSize="13" Margin="8,0,0,0" VerticalAlignment="Center"
                                   Foreground="{StaticResource TextPrimaryBrush}" Text="暂停录屏" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= 底部状态栏 ================= -->
        <Border Grid.Row="3" Background="{StaticResource StatusBarBrush}"
                BorderBrush="{StaticResource CardBorderBrush}" BorderThickness="0,1,0,0"
                Margin="0,20,0,0" Padding="28,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="22" Height="22" CornerRadius="11"
                            Background="{StaticResource OkGreenBrush}">
                        <TextBlock Text="✓" FontSize="13" FontWeight="Bold" Foreground="#FFFFFF"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <Ellipse x:Name="RecDot" Width="12" Height="12" Fill="#FF3B30"
                             Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed" />
                    <TextBlock x:Name="StatusText" FontSize="14" FontWeight="SemiBold" Margin="10,0,0,0"
                               Foreground="{StaticResource TextPrimaryBrush}" VerticalAlignment="Center"
                               Text="就绪 · 可随时截图或录屏" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource ToolButton}" Click="OnOpenShotFolderClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE8B7;" FontSize="14"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="截图目录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnOpenRecordFolderClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE714;" FontSize="14"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="录屏目录" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Click="OnSettingsClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE713;" FontSize="14"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="设置" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                    <Button Style="{StaticResource ToolButton}" Margin="0,0,0,0"
                            Click="OnMinimizeToTrayClick">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock FontFamily="Segoe MDL2 Assets" Text="&#xE769;" FontSize="14"
                                       Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="最小化到托盘" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
