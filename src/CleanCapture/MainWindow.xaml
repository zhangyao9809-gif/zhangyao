<Window x:Class="CleanCapture.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="CleanCapture — 截图录屏（自用）"
        Width="520" Height="430"
        ResizeMode="CanMinimize"
        WindowStartupLocation="CenterScreen">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock Grid.Row="0" FontSize="20" FontWeight="Bold" Text="CleanCapture" />
        <TextBlock Grid.Row="1" Foreground="Gray" TextWrapping="Wrap"
                   Text="自用小工具：截图 PNG 无损，录屏分真无损 / 高清两档，只录系统声，不录麦克风。" />

        <GroupBox Grid.Row="2" Header="截图" Margin="0,14,0,0" Padding="10">
            <StackPanel Orientation="Horizontal">
                <Button x:Name="RegionShotButton" Content="区域截图" Click="OnRegionShotClick" />
                <Button x:Name="FullscreenShotButton" Content="全屏截图" Click="OnFullscreenShotClick" />
                <Button x:Name="WindowShotButton" Content="窗口截图…" Click="OnWindowShotClick" />
            </StackPanel>
        </GroupBox>

        <GroupBox Grid.Row="3" Header="录屏" Margin="0,10,0,0" Padding="10">
            <StackPanel>
                <StackPanel Orientation="Horizontal">
                    <Button x:Name="RecordButton" Content="开始录屏" Click="OnRecordClick" />
                    <Button x:Name="PauseButton" Content="暂停" IsEnabled="False" Click="OnPauseClick" />
                    <ComboBox x:Name="RecordScopeBox" Width="130" Margin="0,0,8,8" SelectedIndex="0">
                        <ComboBoxItem Content="全屏" />
                        <ComboBoxItem Content="区域…" />
                        <ComboBoxItem Content="窗口…" />
                    </ComboBox>
                </StackPanel>
                <TextBlock x:Name="StatusText" Text="未在录制" />
                <TextBlock x:Name="SizeHintText" Foreground="Gray" TextWrapping="Wrap" />
            </StackPanel>
        </GroupBox>

        <TextBlock Grid.Row="4" Margin="0,12,0,0" TextWrapping="Wrap" Foreground="Gray"
                   Text="快捷键：区域截图 Ctrl+Shift+S，全屏截图 Ctrl+Shift+F，开始/停止录屏 Ctrl+Shift+R，暂停 Ctrl+Shift+P（都可以在设置里改）。" />

        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="设置…" Click="OnSettingsClick" />
            <Button Content="最小化到托盘" Click="OnMinimizeToTrayClick" />
        </StackPanel>
    </Grid>
</Window>
