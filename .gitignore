# 编译产物（不要提交）
bin/
obj/
out/
publish/

# Visual Studio 个人设置
.vs/
*.user
*.suo
*.userosscache
*.sln.docstates

# NuGet 包（别人拉代码后会自动还原）
packages/
*.nupkg

# FFmpeg 二进制很大，不要进仓库
# 正确做法：每台电脑自己下载一次，放程序旁边，见 README 第 4 节
ffmpeg.exe
ffprobe.exe
ffmpeg/
ffmpeg-*-essentials_build/
ffmpeg-*-full_build/

# 本地设置文件（每个人保存路径、快捷键可能不一样）
CleanCapture.settings.json

# 录出来的临时文件和成片（桌面才是成片位置，工程里不放）
*.mp4
*.mkv
*.wav
*.png
!docs/*.png
temp/
*.tmp

# Windows / macOS 系统文件
Thumbs.db
Desktop.ini
.DS_Store
